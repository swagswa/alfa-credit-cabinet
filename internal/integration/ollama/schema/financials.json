{
  "type": "object",
  "properties": {
    "inn": {"type": "string", "pattern": "^[0-9]{10}([0-9]{2})?$"},
    "year": {"type": "integer"},
    "revenue": {"$ref": "#/$defs/amount"},
    "net_profit": {"$ref": "#/$defs/amount"},
    "liabilities_long": {"$ref": "#/$defs/amount"},
    "liabilities_short": {"$ref": "#/$defs/amount"},
    "balance_total": {"$ref": "#/$defs/amount"}
  },
  "required": ["inn", "year", "revenue", "net_profit", "liabilities_long", "liabilities_short", "balance_total"],
  "$defs": {
    "amount": {"type": "string", "pattern": "^-?[(]?[0-9][0-9 ]*([,.][0-9]{1,2})?[)]?$"}
  }
}
