meta {
  name: 28 Вход андеррайтера
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "login": "underwriter",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.user.role: eq underwriter
}

script:post-response {
  const c = res.getHeader("set-cookie");
  bru.setVar("uwCookie", [].concat(c)[0].split(";")[0]);
}
