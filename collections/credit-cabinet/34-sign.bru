meta {
  name: 33 Подписать
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/applications/{{northId}}/sign
  body: json
  auth: none
}

headers {
  Cookie: {{northCookie}}
}

body:json {
  {
    "code": "{{signCode}}"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq issued
}

docs {
  Верный код: смоделированная выдача и issued. Через CLOSE_AFTER (на стенде минута) заявка закрывается сама (40).
}
