meta {
  name: 19 Вход менеджера
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{bankLogin}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.user.role: eq manager
}

script:post-response {
  const c = res.getHeader("set-cookie");
  bru.setVar("bankCookie", [].concat(c)[0].split(";")[0]);
}
