# Скопировать в .env только если нужно поменять значения по умолчанию из compose.yaml.
# На стенде с внешним адресом JWT_SECRET и POSTGRES_PASSWORD задавать обязательно.

POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
JWT_SECRET=demo-only-jwt-secret-replace-outside-demo

LOG_LEVEL=info
# true только вместе с профилем ai: docker compose --profile ai up
AI_ENABLED=false

# тестовые учётки и демо-компании, пароль у всех demo12345
SEED_DEMO=true

# false только для стенда по http, за https включить
COOKIE_SECURE=false
LOGIN_ATTEMPTS=10
LOGIN_WINDOW=1m

# сколько ждать ответа клиента, SLA андеррайтера и срок условий; на проде 168h (5 рабочих дней), 24h и 240h
NEED_INFO_TTL=10m
REVIEW_SLA=5m
OFFER_TTL=5m
# срок подписи, через сколько после выдачи заявка закрывается и сколько живёт код; на проде 72h, 24h, 5m
SIGNING_TTL=5m
CLOSE_AFTER=1m
SIGNING_CODE_TTL=5m

# трейсы в Jaeger, только вместе с профилем obs (make up-obs ставит сам)
OTEL_ENDPOINT=

# порты на хосте
DB_PORT=5432
WEB_PORT=8000
