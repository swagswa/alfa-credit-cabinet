    {
      "type": "timeseries",
      "title": "Ответы источников (моки)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{instance=\"mocks:9100\",http_route!=\"/health\"}[1m]))",
          "legendFormat": "{{http_route}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
