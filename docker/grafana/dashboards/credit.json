    },
    {
      "type": "timeseries",
      "title": "Процессы завершены",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (workflow_type) (increase(temporal_workflow_completed{job=\"credit\"}[5m]))",
          "legendFormat": "{{workflow_type}}"
        }
