    {
      "type": "logs",
      "title": "Ошибки и предупреждения",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "trace_id в строке ведёт в трейс Jaeger",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service=~\"api|worker|docs-worker|mocks\", level=~\"error|warn\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
