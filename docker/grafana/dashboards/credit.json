      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Срок шага прошёл",
      "description": "Клиент или сотрудник не успел в срок, процесс скоро переведёт заявку в expired или уже эскалировал",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FROM applications WHERE due_at < now() AND status IN ('need_info', 'manual_review', 'approved', 'counter_offer', 'signing')"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Выдано за сутки, руб.",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(amount_kop), 0) / 100 FROM payouts WHERE created_at > now() - interval '24 hours'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Где сейчас заявки",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT status, count(*) AS заявок FROM applications WHERE status <> 'draft' GROUP BY status ORDER BY 2 DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "status",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "submitted": {
                  "text": "Подана"
                },
                "checking": {
                  "text": "Проверки"
                },
                "need_info": {
                  "text": "Ждём клиента: дозапрос"
                },
                "scoring": {
                  "text": "Скоринг"
                },
                "approved": {
                  "text": "Одобрена, ждём клиента"
                },
                "counter_offer": {
                  "text": "Встречное, ждём клиента"
                },
                "manual_review": {
                  "text": "Ручное рассмотрение"
                },
                "rejected": {
                  "text": "Отказ"
                },
                "accepted": {
                  "text": "Условия приняты"
                },
                "signing": {
                  "text": "Подписание"
                },
                "issued": {
                  "text": "Выдана"
                },
                "closed": {
                  "text": "Закрыта"
                },
                "cancelled_by_client": {
                  "text": "Отменена клиентом"
                },
                "expired": {
                  "text": "Срок истёк"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Решения и ручное рассмотрение",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '5m'), to_status AS metric, count(*) AS value FROM application_events WHERE $__timeFilter(created_at) AND to_status IN ('approved', 'counter_offer', 'rejected', 'manual_review', 'need_info') GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "approved"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Одобрено"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "counter_offer"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Встречное"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Отказ"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "manual_review"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ручное рассмотрение"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "need_info"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Дозапрос"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 14,
        "h": 9
      }
